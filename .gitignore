# =========================================================
# Dinner Fund - GitHub Safe .gitignore
# =========================================================

# Python cache / compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Flask local database / local data
instance/
*.db
*.sqlite
*.sqlite3

# Environment variables / secrets
.env
.env.*
!.env.example

# Private keys / certificates
*.pem
*.key
*.secret

# Testing / cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# VS Code / IDE
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs / temporary files
*.log
*.tmp
*.temp
*.bak
*.backup
*.cache
*.pid

# Backup/archive files
*.zip
*.rar
*.7z
*.tar
*.gz

# Node.js dependencies if used later
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*